<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- CA1707: Allow underscores in test method names (e.g. UnitOfWork_State_ExpectedBehavior) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn> 
  </PropertyGroup>
</Project>