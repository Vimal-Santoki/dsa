<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- API Metadata -->
    <Description>Enterprise-grade Reference Implementation of Data Structures &amp; Algorithms API</Description>
    <PackageTags>dsa;sorting;algorithms;clean-architecture;dotnet-10</PackageTags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Use ONLY the UI package from Swashbuckle (avoids the crash) -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.6.2" />
  </ItemGroup>

</Project>
