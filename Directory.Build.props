<Project>
  <PropertyGroup>
    <!-- Metadata -->
    <Authors>Vimal Santoki</Authors>
    <Company>Vimal</Company>
    <Copyright>Copyright (c) 2026</Copyright>

    <!-- Language & Framework Standards -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Code Quality & Strictness (The Principal Touch) -->
    <AnalysisLevel>10.0-preview</AnalysisLevel> <!-- Enables all newest analyzers -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild> <!-- Fails build on style violations -->
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors> <!-- Zero tolerance for warnings -->
    
    <!-- Deterministic Builds (for reproducible CI/CD) -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Suppress specific analyzer warnings -->
    <NoWarn>$(NoWarn);CA1848</NoWarn>
  </PropertyGroup>
</Project>